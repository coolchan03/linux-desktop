#!/data/data/com.termux/files/usr/bin/bash
# Validate a functional XFCE install, not merely a successful package command.
MARK="$HOME/.config/linux-desktop"
mkdir -p "$MARK"
PACKAGES=(procps xorg-xrandr xkeyboard-config xfce4 xfce4-terminal thunar mousepad pulseaudio dbus mesa)
COMMANDS=(startxfce4 xfce4-session xfce4-panel xfwm4 xfdesktop xfce4-terminal thunar dbus-launch pulseaudio xrandr)
missing=()
for pkg in "${PACKAGES[@]}"; do
  status="$(dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null)"
  [ "$status" = "install ok installed" ] || missing+=("package:$pkg")
done
for exe in "${COMMANDS[@]}"; do
  command -v "$exe" >/dev/null 2>&1 || missing+=("command:$exe")
done
if [ "${#missing[@]}" -gt 0 ]; then
  printf 'Desktop verification failed. Missing components:
' > "$MARK/verify.log"
  printf '%s
' "${missing[@]}" >> "$MARK/verify.log"
  exit 1
fi
rm -f "$MARK/verify.log"
exit 0
