#!/data/data/com.termux/files/usr/bin/bash
# Generated by the app on every launch (the APK path changes when the app is updated).
# Starts the X server that is built into this app.
if [ ! -e /system/bin/app_process ]; then
  echo "Standard Android is required to run the X server."
  exit 1
fi
[ -z "${LD_LIBRARY_PATH+x}" ] || export XSTARTUP_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
[ -z "${LD_PRELOAD+x}" ] || export XSTARTUP_LD_PRELOAD="$LD_PRELOAD"
[ -z "${CLASSPATH+x}" ] || export XSTARTUP_CLASSPATH="$CLASSPATH"
export CLASSPATH="@APK_PATH@"
export LXDESK_X11_NATIVE_LIB="@NATIVE_LIB_DIR@/libXlorie.so"
unset LD_LIBRARY_PATH LD_PRELOAD
[ -n "$(trap -p USR1)" ] && export TERMUX_X11_NOTIFY_PARENT=1
exec /system/bin/app_process -Xnoimage-dex2oat / --nice-name="termux-x11 $*" com.termux.x11.CmdEntryPoint "$@"
