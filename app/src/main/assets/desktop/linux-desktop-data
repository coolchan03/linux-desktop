#!/data/data/com.termux/files/usr/bin/bash
# Keeps your own files (Documents, Downloads, Pictures, Music, Videos, Projects) on an SD card or another
# shared-storage folder. The Linux system itself must stay on internal storage: programs cannot run from
# SD cards, and they cannot hold the symlinks and permissions Linux needs.
#
# The target folder is read from ~/.config/linux-desktop/datadir. Empty means internal storage.
# Existing files are copied first; nothing is deleted until the copy has succeeded, and data left on the
# previous location is never removed.

MARK="$HOME/.config/linux-desktop"
mkdir -p "$MARK"
TARGET="$(cat "$MARK/datadir" 2>/dev/null)"
DIRS=(Documents Downloads Music Pictures Projects Videos)
status() { echo "$1|$2" > "$MARK/data-state"; }
PID_FILE="$MARK/data.pid"

# Do not let two storage migrations race with each other.
if [ -f "$PID_FILE" ]; then
  old_pid="$(cat "$PID_FILE" 2>/dev/null)"
  if [ -n "$old_pid" ] && [ -r "/proc/$old_pid/cmdline" ] && tr '\0' ' ' < "/proc/$old_pid/cmdline" | grep -q 'linux-desktop-data'; then
    if [ "${1:-}" = "--purge-backups" ]; then
      status failed "Wait for the current storage move or backup cleanup to finish."
      exit 1
    fi
    status running "A file move is already in progress"
    exit 0
  fi
  rm -f "$PID_FILE"
fi
echo $$ > "$PID_FILE"
trap 'rm -f "$PID_FILE"' EXIT

fail() {
  echo "$*" >&2
  status failed "$*"
  exit 1
}

# Only the folders created by this script may be purged. Never follow backup links.
valid_backup_name() {
  [[ "${1##*/}" =~ ^backup-(Documents|Downloads|Music|Pictures|Projects|Videos)-[0-9]+-[0-9]+$ ]]
}

backup_size_kb() {
  local path n total=0
  for path in "$MARK"/backup-*; do
    [ -d "$path" ] && [ ! -L "$path" ] && valid_backup_name "$path" || continue
    n="$(du -sk "$path" 2>/dev/null | awk 'NR==1 {print $1}')"
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    total=$((total + n))
  done
  echo "$total"
}

if [ "${1:-}" = "--purge-backups" ]; then
  applied="$(cat "$MARK/datadir-applied" 2>/dev/null)"
  [ -n "$TARGET" ] && [ "$TARGET" = "$applied" ] ||
    fail "Cannot delete backups until external storage is selected and migration completes."
  [ -d "$TARGET" ] && [ -w "$TARGET" ] ||
    fail "Cannot access the applied storage destination. Reconnect it before cleaning backups."
  probe="$TARGET/.lxdesk-purge-test-$$"
  (umask 077; : > "$probe") 2>/dev/null ||
    fail "The applied storage destination is not writable."
  rm -f "$probe"
  for d in "${DIRS[@]}"; do
    expected="$TARGET/$d"
    [ -L "$HOME/$d" ] && [ "$(readlink "$HOME/$d")" = "$expected" ] && [ -d "$expected" ] ||
      fail "The $d folder does not point to the applied destination; backups were kept."
  done
  status running "Deleting confirmed internal backup copies"
  freed_kb=0
  removed=0
  for backup in "$MARK"/backup-*; do
    [ -d "$backup" ] && [ ! -L "$backup" ] && valid_backup_name "$backup" || continue
    size="$(du -sk "$backup" 2>/dev/null | awk 'NR==1 {print $1}')"
    [[ "$size" =~ ^[0-9]+$ ]] || size=0
    rm -rf -- "$backup" || fail "Could not delete an old backup: ${backup##*/}"
    freed_kb=$((freed_kb + size))
    removed=$((removed + 1))
  done
  status done "Deleted $removed old internal backup folders (approximately $(((freed_kb + 1023) / 1024)) MB)."
  exit 0
fi

if pgrep -x xfce4-session >/dev/null 2>&1; then
  fail "Stop the desktop before moving files"
fi

status running "Moving your files"

if [ -n "$TARGET" ]; then
  mkdir -p "$TARGET" 2>/dev/null
  [ -d "$TARGET" ] && [ -w "$TARGET" ] || fail "Cannot write to $TARGET. Check selected-folder permission; SD card may be mounted but inaccessible."
  PROBE="$TARGET/.lxdesk-write-test-$$"
  (umask 077; : > "$PROBE") 2>/dev/null || fail "Selected storage is mounted but refuses file writes: $TARGET"
  rm -f "$PROBE"
fi

for d in "${DIRS[@]}"; do
  src="$HOME/$d"
  current=""
  [ -L "$src" ] && current="$(readlink "$src")"

  if [ -n "$TARGET" ]; then
    dst="$TARGET/$d"
    [ "$current" = "$dst" ] && continue
    mkdir -p "$dst" || fail "Cannot create $dst"
    if [ -L "$src" ]; then
      # Was stored somewhere else before: copy it across, leave the old copy alone.
      [ -d "$current" ] || fail "Existing $d storage is unavailable: $current. Not replacing the link."
      cp -r "$current/." "$dst/" || fail "Could not copy $d to $dst (a file name may not be allowed on that card)"
      rm -f "$src"
    elif [ -d "$src" ]; then
      cp -r "$src/." "$dst/" || fail "Could not copy $d to $dst (a file name may not be allowed on that card)"
      backup="$MARK/backup-$d-$(date +%s)-$$"
      mv "$src" "$backup" || fail "Could not preserve original $d"
    fi
    if ! ln -s "$dst" "$src"; then
      [ -n "${backup:-}" ] && [ -d "$backup" ] && mv "$backup" "$src" 2>/dev/null || true
      fail "Could not link $src; original was preserved"
    fi
    backup=""
  else
    # Back to internal storage.
    [ -L "$src" ] || { mkdir -p "$src"; continue; }
    tmp="$HOME/.linux-desktop-data-$d.$$"
    rm -rf "$tmp"
    mkdir -p "$tmp" || fail "Could not prepare internal storage for $d"
    [ -d "$current" ] || { rm -rf "$tmp"; fail "Previous $d storage is unavailable: $current. Files were not changed."; }
    cp -r "$current/." "$tmp/" || { rm -rf "$tmp"; fail "Could not copy $d back to internal storage"; }
    rm -f "$src"
    mv "$tmp" "$src" || fail "Could not restore $d to internal storage"
  fi
done

echo "$TARGET" > "$MARK/datadir-applied"
remaining_kb="$(backup_size_kb)"
backup_message=""
if [ "$remaining_kb" -gt 0 ]; then
  backup_message=". Old internal backups use approximately $(((remaining_kb + 1023) / 1024)) MB; delete them from Storage location after verifying your files."
fi
status done "Your files are now stored in ${TARGET:-internal storage}${backup_message}"
exit 0
