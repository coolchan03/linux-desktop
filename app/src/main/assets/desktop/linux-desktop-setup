#!/data/data/com.termux/files/usr/bin/bash
# Installs the core of the Linux desktop: XFCE4, audio and GPU acceleration. This is the part needed to
# see a working desktop, so it is kept small; apps and tools follow in the background (linux-desktop-extras).
# Package selection follows https://github.com/techjarves/termux-hacklab (Mobile HackLab).
#
# The APK normally carries these packages (see lxdesk_unpack_pack in lxdesk-common.sh), so they are
# installed without downloading anything. Without a usable pack they are downloaded instead.

MARK="$HOME/.config/linux-desktop"
mkdir -p "$MARK"
. "$PREFIX/bin/lxdesk-common.sh"
lxdesk_rotate_log "$MARK/setup.log"
# Everything this script prints is kept for troubleshooting ("Copy debug info" includes the end of it).
[ -t 1 ] || exec >>"$MARK/setup.log" 2>&1
echo "=== setup started $(date) ==="
# The app's setup screen reads these files to show progress.
progress() { echo "$1|$2" > "$MARK/progress"; }
state() { echo "$1" > "$MARK/state"; }
# Let the Android UI distinguish a genuinely running installer from a stale progress file after a crash.
echo $$ > "$MARK/setup.pid"
PARENT=$$
TICKER=""
cleanup() {
  [ -z "$TICKER" ] || kill "$TICKER" 2>/dev/null || true
  rm -f "$MARK/setup.pid"
}
trap cleanup EXIT
trap 'exit 143' TERM HUP INT
state running
progress 1 "Preparing the Linux system"

# Termux's bootstrap needs a one-time "second stage" (it runs the install scripts of the base packages).
# Termux normally triggers it from the login shell's startup files, which this background shell never reads,
# so without this step apt runs on a half-configured system and package installs fail.
SECOND_STAGE="$PREFIX/etc/termux/termux-bootstrap/second-stage/termux-bootstrap-second-stage.sh"
SECOND_STAGE_FAILED="$MARK/bootstrap-second-stage-failed"

# Upstream creates .lock before running post-install scripts and leaves it behind if one fails.
# Only clear that lock when our previous run positively recorded a second-stage failure.
if [ -f "$SECOND_STAGE_FAILED" ]; then
  echo "Retrying previously failed Termux bootstrap second stage"
  rm -f "$SECOND_STAGE.lock"
fi

if [ -f "$SECOND_STAGE" ] && [ ! -L "$SECOND_STAGE.lock" ]; then
  echo "Running the Termux bootstrap second stage"
  /system/bin/chmod +x "$SECOND_STAGE"
  if ! "$SECOND_STAGE"; then
    echo "Second stage failed" >&2
    touch "$SECOND_STAGE_FAILED"
    progress 0 "The Linux system could not be finished (base package setup failed). Tap Copy debug info and send it to the developer."
    state failed
    exit 1
  fi
  rm -f "$SECOND_STAGE_FAILED"
fi

# Repair anything an earlier attempt left half-installed.
repair() {
  # dpkg may initially fail on missing dependencies: apt fixes these, then
  # finish every pending maintainer script. Only the final result is trusted.
  DEBIAN_FRONTEND=noninteractive dpkg --configure -a || true
  DEBIAN_FRONTEND=noninteractive apt-get -f install -y || return 1
  DEBIAN_FRONTEND=noninteractive dpkg --configure -a
}
# The bootstrap's config files were rewritten for this app's path, so dpkg sees them as changed locally and
# would stop at a "keep your version?" question whenever their package is upgraded. Nobody can answer that in
# a background install: keep the current (already rewritten) file, as dpkg does by default for changed files.
mkdir -p "$PREFIX/etc/apt/apt.conf.d"
printf '%s\n' '// Written by LXDesk: never stop at config file questions during background installs.' \
  'Dpkg::Options { "--force-confdef"; "--force-confold"; };' > "$PREFIX/etc/apt/apt.conf.d/98-lxdesk-dpkg-options"

if ! repair >"$MARK/repair.log" 2>&1; then
  progress 0 "The package manager could not recover. See repair.log for details."
  state failed
  exit 1
fi

# ---- Desktop packages bundled in the APK ----
BUNDLE="$PREFIX/var/cache/lxdesk-desktop-pack"
BUNDLED=0
bundle_apt() { lxdesk_pack_apt "$BUNDLE" "$@"; }

install_from_bundle() {
  local total ticker status
  progress 4 "Unpacking the desktop included in the app"
  lxdesk_unpack_pack "$BUNDLE" || return 1
  total="$(wc -l < "$BUNDLE/manifest.txt")"
  [ "$total" -gt 0 ] || total=1
  # One apt run installs everything; count finished packages for the progress bar.
  : > "$MARK/last-pkg.log"
  (
    while kill -0 "$PARENT" 2>/dev/null; do
      done_count="$(grep -c '^Setting up ' "$MARK/last-pkg.log" 2>/dev/null)"
      [ "${done_count:-0}" -le "$total" ] || done_count=$total
      logline="$(tail -n 1 "$MARK/last-pkg.log" 2>/dev/null | cut -c1-110)"
      progress "$((8 + 87 * ${done_count:-0} / total))" "Installing the desktop from the app, no download needed - ${logline:-preparing}"
      sleep 2
    done
  ) &
  ticker=$!
  TICKER=$ticker
  bundle_apt install -y "${CORE_PACKAGES[@]}" x11-repo > "$MARK/last-pkg.log" 2>&1
  status=$?
  kill "$ticker" 2>/dev/null || true
  wait "$ticker" 2>/dev/null || true
  TICKER=""
  cat "$MARK/last-pkg.log"
  return "$status"
}

say() { printf '\n==> %s\n' "$*"; }
say "Installing the desktop included in the app"
if install_from_bundle >"$MARK/bundle.log" 2>&1; then
  BUNDLED=1
  progress 95 "Installed the desktop from the app"
else
  echo "Bundled desktop packages could not be used; downloading them instead (see bundle.log)"
  # Leave dpkg consistent for the download path below.
  [ -f "$BUNDLE/sources.list" ] && bundle_apt -f install -y >>"$MARK/bundle.log" 2>&1
  DEBIAN_FRONTEND=noninteractive dpkg --configure -a >>"$MARK/bundle.log" 2>&1 || true
fi

TOTAL=0; DONE=0; FAILED=()

install_pkg() {
  DONE=$((DONE + 1))
  local pkgname="$1" attempt logline ticker pct
  pct=$((10 + 85 * (DONE - 1) / TOTAL))
  for attempt in 1 2; do
    : > "$MARK/last-pkg.log"
    progress "$pct" "Installing $pkgname ($DONE/$TOTAL), attempt $attempt - resolving dependencies"
    # pkg may install many dependencies for one top-level package. Refresh the
    # activity text rather than incorrectly increasing a guessed percentage.
    (
      elapsed=0
      while kill -0 "$PARENT" 2>/dev/null; do
        logline="$(tail -c 4096 "$MARK/last-pkg.log" 2>/dev/null | tr '\r' '\n' | grep -E '^(Get:|Fetched |Unpacking |Setting up |Preparing to unpack |Processing triggers|Reading package lists|Building dependency tree)' | tail -n 1 | cut -c1-110)"
        [ -n "$logline" ] || logline="downloading or configuring dependencies"
        progress "$pct" "Installing $pkgname ($DONE/$TOTAL), ${elapsed}s - $logline"
        sleep 3
        elapsed=$((elapsed + 3))
      done
    ) &
    ticker=$!
    TICKER=$ticker
    if DEBIAN_FRONTEND=noninteractive pkg install -y "$pkgname" > "$MARK/last-pkg.log" 2>&1; then
      kill "$ticker" 2>/dev/null || true
      wait "$ticker" 2>/dev/null || true
      TICKER=""
      progress "$((10 + 85 * DONE / TOTAL))" "Installed $pkgname ($DONE/$TOTAL)"
      return 0
    fi
    kill "$ticker" 2>/dev/null || true
    wait "$ticker" 2>/dev/null || true
    TICKER=""
    cp "$MARK/last-pkg.log" "$MARK/failed-$(printf '%02d' "$DONE")-$pkgname-attempt$attempt.log"
    progress "$pct" "Repairing package manager after $pkgname failed (attempt $attempt)"
    repair >> "$MARK/last-pkg.log" 2>&1 || true
    sleep 2
  done
  FAILED+=("$pkgname")
  return 0  # Report all failures after the install loop.
}

# Core packages: keep first boot conservative. Current Termux ships Zink inside the regular mesa package.
# GPU-specific Vulkan drivers are optional so a stale/missing driver package can never block XFCE itself.
CORE=("${CORE_PACKAGES[@]}")

rm -f "$MARK"/failed-*.log
if [ "$BUNDLED" = 0 ]; then
  say "Updating package lists"
  progress 2 "Updating package lists"
  if ! DEBIAN_FRONTEND=noninteractive pkg update -y >"$MARK/update-initial.log" 2>&1; then
    progress 0 "Could not update package lists. Check your network and repository settings."
    state failed
    exit 1
  fi
  progress 5 "Adding package repositories"
  if ! DEBIAN_FRONTEND=noninteractive pkg install -y x11-repo >"$MARK/repo-x11.log" 2>&1; then
    progress 0 "Could not enable the X11 package repository. Tap Copy debug info and send it to the developer."
    state failed
    exit 1
  fi
  # TUR is useful for optional/community packages but is not required for the XFCE desktop itself.
  # Do not let a temporary TUR issue prevent the desktop from installing.
  DEBIAN_FRONTEND=noninteractive pkg install -y tur-repo >"$MARK/repo-tur.log" 2>&1 || true
  if ! DEBIAN_FRONTEND=noninteractive pkg update -y >"$MARK/update-final.log" 2>&1; then
    progress 0 "Could not refresh X11 package lists. Check network and repository availability."
    state failed
    exit 1
  fi

  TOTAL=${#CORE[@]}
  say "Installing the desktop ($TOTAL packages)"
  for p in "${CORE[@]}"; do install_pkg "$p"; done

  if [ ${#FAILED[@]} -gt 0 ]; then
    say "Could not install: ${FAILED[*]}"
    progress 0 "Could not install ${FAILED[0]}. Check your internet connection and try again."
    state failed
    exit 1
  fi
fi

# Graphics must never make first boot fail. Mesa provides llvmpipe/softpipe as a safe fallback.
GPU_PROFILE="$HOME/.config/hacklab-gpu.sh"
: > "$GPU_PROFILE"
# Background shells only have $PREFIX/bin on PATH, so call Android's getprop directly.
GPU_VENDOR="$(/system/bin/getprop ro.hardware.egl 2>/dev/null; /system/bin/getprop ro.hardware.vulkan 2>/dev/null)"
GPU_VENDOR="$(printf '%s' "$GPU_VENDOR" | tr '[:upper:]' '[:lower:]')"
GPU_PACKAGES=(vulkan-loader-generic mesa-vulkan-icd-freedreno)
install_gpu_packages() {
  if [ "$BUNDLED" = 1 ] && bundle_apt install -y "${GPU_PACKAGES[@]}"; then
    return 0
  fi
  DEBIAN_FRONTEND=noninteractive pkg install -y "${GPU_PACKAGES[@]}"
}
if echo "$GPU_VENDOR" | grep -q adreno; then
  progress 96 "Enabling optional Adreno GPU acceleration"
  echo "Trying optional Adreno/Turnip acceleration" > "$MARK/gpu.log"
  if install_gpu_packages >>"$MARK/gpu.log" 2>&1; then
    cat > "$GPU_PROFILE" <<'EOF'
export GALLIUM_DRIVER=zink
export MESA_LOADER_DRIVER_OVERRIDE=zink
export TU_DEBUG=noconform
EOF
    echo "Adreno/Turnip acceleration enabled" >> "$MARK/gpu.log"
  else
    echo "Optional GPU packages failed; using Mesa software rendering instead." | tee -a "$MARK/gpu.log"
    repair >>"$MARK/gpu.log" 2>&1 || true
  fi
else
  echo "No explicit Adreno GPU detected; using Mesa software rendering." > "$MARK/gpu.log"
fi

mkdir -p "$HOME/Desktop"
printf '[Desktop Entry]\nName=Terminal\nExec=xfce4-terminal\nIcon=utilities-terminal\nType=Application\nCategories=System;TerminalEmulator;\n' > "$HOME/Desktop/Terminal.desktop"
for shortcut in "$HOME"/Desktop/*.desktop; do
  [ -f "$shortcut" ] && /system/bin/chmod 755 "$shortcut"
done

# One authoritative validation path; reruns safely on partial installs.
progress 98 "Verifying the desktop and its dependencies"
if ! linux-desktop-verify; then
  rm -f "$MARK/installed-v1"
  missing="$(sed -n '2p' "$MARK/verify.log" 2>/dev/null)"
  progress 0 "Desktop setup incomplete: ${missing:-see verify.log}. Tap Try again to repair."
  state failed
  exit 1
fi
touch "$MARK/installed-v1"
# The bundled packages are installed now; the copy inside the APK remains for repairs.
rm -rf "$BUNDLE"
progress 100 "Done"
state done
exit 0
