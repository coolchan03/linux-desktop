#!/data/data/com.termux/files/usr/bin/bash
# Installs the core of the Linux desktop: XFCE4, audio and GPU acceleration. This is the part needed to
# see a working desktop, so it is kept small; apps and tools follow in the background (linux-desktop-extras).
# Package selection follows https://github.com/techjarves/termux-hacklab (Mobile HackLab).

MARK="$HOME/.config/linux-desktop"
mkdir -p "$MARK"
# Everything this script prints is kept for troubleshooting ("Copy debug info" includes the end of it).
[ -t 1 ] || exec >>"$MARK/setup.log" 2>&1
echo "=== setup started $(date) ==="
# The app's setup screen reads these files to show progress.
progress() { echo "$1|$2" > "$MARK/progress"; }
state() { echo "$1" > "$MARK/state"; }
# Let the Android UI distinguish a genuinely running installer from a stale progress file after a crash.
echo $$ > "$MARK/setup.pid"
trap 'rm -f "$MARK/setup.pid"' EXIT
state running
progress 1 "Preparing the Linux system"

# Termux's bootstrap needs a one-time "second stage" (it runs the install scripts of the base packages).
# Termux normally triggers it from the login shell's startup files, which this background shell never reads,
# so without this step apt runs on a half-configured system and package installs fail.
SECOND_STAGE="$PREFIX/etc/termux/termux-bootstrap/second-stage/termux-bootstrap-second-stage.sh"
SECOND_STAGE_FAILED="$MARK/bootstrap-second-stage-failed"

# Upstream creates .lock before running post-install scripts and leaves it behind if one fails.
# Only clear that lock when our previous run positively recorded a second-stage failure.
if [ -f "$SECOND_STAGE_FAILED" ]; then
  echo "Retrying previously failed Termux bootstrap second stage"
  rm -f "$SECOND_STAGE.lock"
fi

if [ -f "$SECOND_STAGE" ] && [ ! -L "$SECOND_STAGE.lock" ]; then
  echo "Running the Termux bootstrap second stage"
  chmod +x "$SECOND_STAGE"
  if ! "$SECOND_STAGE"; then
    echo "Second stage failed" >&2
    touch "$SECOND_STAGE_FAILED"
    progress 0 "The Linux system could not be finished (base package setup failed). Tap Copy debug info and send it to the developer."
    state failed
    exit 1
  fi
  rm -f "$SECOND_STAGE_FAILED"
fi

# Repair anything an earlier attempt left half-installed.
repair() {
  DEBIAN_FRONTEND=noninteractive dpkg --configure -a
  DEBIAN_FRONTEND=noninteractive apt-get -f install -y
}
if ! repair >"$MARK/repair.log" 2>&1; then
  progress 0 "The package manager could not recover. See repair.log for details."
  state failed
  exit 1
fi
progress 2 "Updating package lists"

TOTAL=0; DONE=0; FAILED=()

say() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
install_pkg() {
  DONE=$((DONE + 1))
  progress $((10 + 85 * (DONE - 1) / TOTAL)) "Installing $1 ($DONE of $TOTAL)"
  printf '\033[0;90m[%d/%d]\033[0m %s ... ' "$DONE" "$TOTAL" "$1"
  for attempt in 1 2; do
    if DEBIAN_FRONTEND=noninteractive pkg install -y "$1" >"$MARK/last-pkg.log" 2>&1; then
      printf '\033[0;32mok\033[0m\n'; return 0
    fi
    # Keep every failure: the first one is usually the root cause of the ones after it.
    cp "$MARK/last-pkg.log" "$MARK/failed-$(printf '%02d' "$DONE")-$1-attempt$attempt.log"
    repair >>"$MARK/last-pkg.log" 2>&1
    sleep 2
  done
  printf '\033[0;31mfailed\033[0m\n'
  FAILED+=("$1")
}

# Core packages: keep first boot conservative. Current Termux ships Zink inside the regular mesa package.
# GPU-specific Vulkan drivers are optional so a stale/missing driver package can never block XFCE itself.
CORE=(procps xorg-xrandr xkeyboard-config xfce4 xfce4-terminal thunar mousepad pulseaudio dbus mesa)

say "Updating package lists"
rm -f "$MARK"/failed-*.log
if ! DEBIAN_FRONTEND=noninteractive pkg update -y >"$MARK/update-initial.log" 2>&1; then
  progress 0 "Could not update package lists. Check your network and repository settings."
  state failed
  exit 1
fi
progress 5 "Adding package repositories"
if ! DEBIAN_FRONTEND=noninteractive pkg install -y x11-repo >"$MARK/repo-x11.log" 2>&1; then
  progress 0 "Could not enable the X11 package repository. Tap Copy debug info and send it to the developer."
  state failed
  exit 1
fi
# TUR is useful for optional/community packages but is not required for the XFCE desktop itself.
# Do not let a temporary TUR issue prevent the desktop from installing.
DEBIAN_FRONTEND=noninteractive pkg install -y tur-repo >"$MARK/repo-tur.log" 2>&1 || true
if ! DEBIAN_FRONTEND=noninteractive pkg update -y >"$MARK/update-final.log" 2>&1; then
  progress 0 "Could not refresh X11 package lists. Check network and repository availability."
  state failed
  exit 1
fi

TOTAL=${#CORE[@]}
say "Installing the desktop ($TOTAL packages)"
for p in "${CORE[@]}"; do install_pkg "$p"; done

if [ ${#FAILED[@]} -gt 0 ]; then
  say "Could not install: ${FAILED[*]}"
  progress 0 "Could not install ${FAILED[0]}. Check your internet connection and try again."
  state failed
  exit 1
fi

# Graphics must never make first boot fail. Mesa provides llvmpipe/softpipe as a safe fallback.
GPU_PROFILE="$HOME/.config/hacklab-gpu.sh"
: > "$GPU_PROFILE"
GPU_VENDOR="$(getprop ro.hardware.egl 2>/dev/null | tr '[:upper:]' '[:lower:]')"
if echo "$GPU_VENDOR" | grep -q adreno; then
  progress 96 "Enabling optional Adreno GPU acceleration"
  echo "Trying optional Adreno/Turnip acceleration" > "$MARK/gpu.log"
  if DEBIAN_FRONTEND=noninteractive pkg install -y vulkan-loader-generic mesa-vulkan-icd-freedreno >>"$MARK/gpu.log" 2>&1; then
    cat > "$GPU_PROFILE" <<'EOF'
export GALLIUM_DRIVER=zink
export MESA_LOADER_DRIVER_OVERRIDE=zink
export TU_DEBUG=noconform
EOF
    echo "Adreno/Turnip acceleration enabled" >> "$MARK/gpu.log"
  else
    echo "Optional GPU packages failed; using Mesa software rendering instead." | tee -a "$MARK/gpu.log"
    repair >>"$MARK/gpu.log" 2>&1 || true
  fi
else
  echo "No explicit Adreno GPU detected; using Mesa software rendering." > "$MARK/gpu.log"
fi

mkdir -p "$HOME/Desktop"
printf '[Desktop Entry]\nName=Terminal\nExec=xfce4-terminal\nIcon=utilities-terminal\nType=Application\nCategories=System;TerminalEmulator;\n' > "$HOME/Desktop/Terminal.desktop"
chmod +x "$HOME"/Desktop/*.desktop 2>/dev/null

touch "$MARK/installed-v1"
progress 100 "Done"
state done
exit 0
